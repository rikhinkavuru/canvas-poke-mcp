# Your school's Canvas URL (no trailing slash)
CANVAS_BASE_URL=https://yourschool.instructure.com

# Canvas personal access token: Account > Settings > Approved Integrations > New Access Token
CANVAS_ACCESS_TOKEN=your_canvas_access_token_here

# Shared secret Poke uses to authenticate to this server.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
POKE_API_KEY=your_strong_random_api_key_here
